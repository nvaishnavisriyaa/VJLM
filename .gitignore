# Raw crawl snapshots — large, regenerable, and may contain full page copies
ingestion/snapshots/**
!ingestion/snapshots/.gitkeep
ingestion/state/**
!ingestion/state/.gitkeep

# Model weights, adapters and quantized builds
*.gguf
*.safetensors
*.bin
*.pt
*.pth
training/adapters/**
training/checkpoints/**
quantization/builds/**

# Vector indexes
rag/index/**
!rag/index/.gitkeep
*.faiss
*.duckdb
*.sqlite3

# Experiment outputs — keep the recorded results, not the bulk artifacts
experiments/**/artifacts/**

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/

# Secrets — never commit
.env
.env.*
!.env.example
*.key
*.pem

# OS / editor
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# llama.cpp release binaries - platform-specific, re-downloaded by setup
runtime/llama/**
runtime/*.zip
runtime/*.log

# Training venv (Python 3.10, built locally by requirements-train.txt)
.venv310/

# Phase 8 driver transient output — raw tqdm redraws and live stage state.
# The evidence is experiments/generation_results.jsonl and each adapter's
# run.json, not this.
experiments/matrix.log
experiments/matrix_status.json

# Published best-step adapters are an intentional exception to the rules above.
# The weights themselves are tracked with Git LFS (Mistral's adapter is 160 MiB
# and GitHub rejects >100 MB in plain git). Optimizer state is NOT published.
!models/
!models/**/*.safetensors
models/**/optimizer.pt
models/**/rng_state.pth
models/**/scheduler.pt

# Phase 9 driver transient state - the evidence is experiments/*.jsonl and
# quantization/builds.json, not the live log.
quantization/quant_matrix.log
quantization/quant_status.json

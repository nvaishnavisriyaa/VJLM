# Raw crawl snapshots — large, regenerable, and may contain full page copies
ingestion/snapshots/**
!ingestion/snapshots/.gitkeep
ingestion/state/**
!ingestion/state/.gitkeep

# Model weights, adapters and quantized builds
*.gguf
*.safetensors
*.bin
*.pt
*.pth
training/adapters/**
training/checkpoints/**
quantization/builds/**

# Vector indexes
rag/index/**
!rag/index/.gitkeep
*.faiss
*.duckdb
*.sqlite3

# Experiment outputs — keep the recorded results, not the bulk artifacts
experiments/**/artifacts/**

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/

# Secrets — never commit
.env
.env.*
!.env.example
*.key
*.pem

# OS / editor
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# llama.cpp release binaries - platform-specific, re-downloaded by setup
runtime/llama/**
runtime/*.zip
runtime/*.log

# Training venv (Python 3.10, built locally by requirements-train.txt)
.venv310/

# Phase 8 driver transient output — raw tqdm redraws and live stage state.
# The evidence is experiments/generation_results.jsonl and each adapter's
# run.json, not this.
experiments/matrix.log
experiments/matrix_status.json

# Published best-step adapters are an intentional exception to the rules above.
# The weights themselves are tracked with Git LFS (Mistral's adapter is 160 MiB
# and GitHub rejects >100 MB in plain git). Optimizer state is NOT published.
!models/
!models/**/*.safetensors
models/**/optimizer.pt
models/**/rng_state.pth
models/**/scheduler.pt

# Phase 9 driver transient state - the evidence is experiments/*.jsonl and
# quantization/builds.json, not the live log.
quantization/quant_matrix.log
quantization/quant_status.json

# Extracted corpus - the knowledge base itself. Uncompressed it is 125MB and
# 129MB, past GitHub's 100MB per-file limit, so the working copies stay ignored
# and the gzipped pair is versioned instead (~28MB each; chunk records are
# repetitive JSON and compress to 22%). A clone restores them with
# preprocessing/restore_corpus.py.
preprocessing/out/rag_chunks.jsonl
preprocessing/out/rag_chunks_enriched.jsonl
!preprocessing/out/rag_chunks.jsonl.gz
!preprocessing/out/rag_chunks_enriched.jsonl.gz

# Structural-chunking experiment (chunker.py). Measured and not adopted - worse
# deeper (@20 80% vs 84%) - so its 231MB corpus and 205MB index are scratch.
preprocessing/out_v2/**
rag/index_v2/**

# Session scratch logs from background runs, not recorded evidence
experiments/_*.log
experiments/_*.json
experiments/_*.py

# Server logs from detached runs
logs/
